{
  "name": "everystate",
  "version": "0.3.1",
  "description": "A TLA+ model checker with no Java dependency (TLC-compatible). Prebuilt native binaries, with a WebAssembly build for use from JavaScript.",
  "type": "module",
  "license": "MIT",
  "main": "wasm/everystate.mjs",
  "types": "wasm/everystate.d.ts",
  "exports": {
    ".": {
      "types": "./wasm/everystate.d.ts",
      "default": "./wasm/everystate.mjs"
    }
  },
  "bin": {
    "everystate": "bin/everystate.mjs",
    "everystate-java": "bin/everystate.mjs"
  },
  "files": [
    "bin/everystate.mjs",
    "native",
    "wasm/everystate.mjs",
    "wasm/everystate.d.ts",
    "wasm/everystate.wasm",
    "wasm/cli.mjs",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "cargo build --release && sh wasm/build.sh",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts && node test/community.mjs",
    "conformance:examples": "node scripts/conformance.mjs",
    "conformance:tlc": "node scripts/diff-tlc.mjs",
    "conformance:statechart": "node scripts/statechart-corpus.mjs",
    "bench": "node scripts/bench.mjs",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-version.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "tla",
    "tlaplus",
    "tlc",
    "model-checker",
    "formal-verification",
    "wasm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattzcarey/everystate.git"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
